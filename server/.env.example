# Copy to .env. These URLs match docker-compose.yml.
#
# The owner of the tables: used only to set up the database (npm run migrate,
# which npm run dev runs for you) and by the seed and create-user scripts.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5433/patient_tracker
# The app's own login, used for every request. npm run migrate creates it
# with this name and password, and only the rights the app needs. Use a
# different, random password outside local development.
DATABASE_URL=postgres://patient_tracker_app:change-me-app-password@localhost:5433/patient_tracker
# Signs session cookies. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
